$dbpw  = Read-Host "Supabase database password (the NEW one)"
$apppw = Read-Host "Gmail App Password (16 letters, or press Enter to skip)"
$jwt   = node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
$vapid = node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))" | ConvertFrom-Json
$enc   = [uri]::EscapeDataString($dbpw)
$apppw = $apppw.Replace(' ','')

@"
PORT=5000
JWT_SECRET=${jwt}
CLIENT_URL=http://localhost:5173
NODE_ENV=development
GOOGLE_CLIENT_ID=779623597984-ql44hvpmsilrf30rv383o5ridncm7jn2.apps.googleusercontent.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=nolwazitheodore@gmail.com
SMTP_PASS=${apppw}
MAIL_FROM=AbilityConnect SA <nolwazitheodore@gmail.com>
VAPID_PUBLIC_KEY=$($vapid.publicKey)
VAPID_PRIVATE_KEY=$($vapid.privateKey)
VAPID_SUBJECT=mailto:nolwazitheodore@gmail.com
GOOGLE_TRANSLATE_KEY=
"@ | Set-Content -Encoding ascii .env
DATABASE_URL=postgresql://postgres.bltwiufqrkemwoefyvjy:TheodoreNolwazi%400505@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
